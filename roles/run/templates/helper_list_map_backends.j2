{# Inputs: tpl_managed_backends, tpl_settings, tpl_package_backends.
   Extract the actual backend from absolute map paths, including proxy:ldap:.
   Only backends with platform package mappings require installation. #}
{% set backends = tpl_managed_backends | ansible.builtin.reject('ansible.builtin.equalto', '') | ansible.builtin.list %}
{% for value in tpl_settings.values() %}
{%   set _ = backends.extend(value | ansible.builtin.string | ansible.builtin.regex_findall('([a-z][a-z0-9_]*):/')) %}
{% endfor %}
{{ backends | ansible.builtin.unique | ansible.builtin.intersect(tpl_package_backends.keys()) | ansible.builtin.sort }}
